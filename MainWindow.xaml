<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="BiliPlay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliPlay"
    xmlns:core="using:BiliPlay.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Bili Play"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot" Background="{ThemeResource AppCanvasBrush}">
        <Grid.Resources>
            <local:AvatarImageConverter x:Key="SocialAvatar"/>
            <DataTemplate x:Key="SocialUserTemplate">
                <Grid Padding="8,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <PersonPicture Width="48" Height="48" ProfilePicture="{Binding Avatar, Converter={StaticResource SocialAvatar}, ConverterParameter=96}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Signature}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="FollowingUserTemplate">
                <Grid Padding="8,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <PersonPicture Width="48" Height="48" ProfilePicture="{Binding Avatar, Converter={StaticResource SocialAvatar}, ConverterParameter=96}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Signature}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Button Grid.Column="2" Content="取消关注" Tag="{Binding}" Click="UnfollowSocialUserClick" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- One backdrop spans the title bar, library and transport controls. -->
        <Grid x:Name="AtmosphereHost" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="AtmosphereSizeChanged">
            <Image x:Name="AmbientBackdrop" Margin="-16" Stretch="Fill"/>
            <Image x:Name="AmbientIncoming" Margin="-16" Stretch="Fill"/>
        </Grid>

        <TitleBar Background="Transparent" x:Name="AppTitleBar" Title="Bili Play" Height="48" SizeChanged="TitleBarSizeChanged"
            IsBackButtonVisible="True" IsBackButtonEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" BackRequested="TitleBackRequested">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
                <SolidColorBrush x:Key="TitleBarBackButtonBackgroundDisabled" Color="Transparent"/>
            </TitleBar.Resources>
            <TitleBar.LeftHeader><Image Source="Assets/Square44x44Logo.scale-200.png" Width="26" Height="26" Margin="0,0,14,0" AutomationProperties.Name="Bili Play"/></TitleBar.LeftHeader>
            <TitleBar.Content>
                <Grid Width="480" x:Name="SearchHost" TitleBar.IsDragRegion="False">
                    <Grid.RenderTransform><TranslateTransform x:Name="SearchShift"/></Grid.RenderTransform>
                    <AutoSuggestBox x:Name="TitleSearch" Height="32" PlaceholderText="搜索歌曲，UP主及更多" QueryIcon="Find" LayoutUpdated="SearchLayoutUpdated"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" QuerySubmitted="TitleSearchSubmitted" TextChanged="SearchTextChanged" GotFocus="SearchGotFocus"
                        IsEnabled="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay}" AutomationProperties.Name="搜索歌曲，UP主及更多"/>
                    <Popup x:Name="SearchHistoryPopup" VerticalOffset="38" IsLightDismissEnabled="False" ShouldConstrainToRootBounds="True">
                        <Popup.ChildTransitions><TransitionCollection><PopupThemeTransition/></TransitionCollection></Popup.ChildTransitions>
                        <Border Width="{Binding ActualWidth, ElementName=SearchHost}" Padding="4" CornerRadius="8" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                <StackPanel Spacing="4">
                                <ItemsControl x:Name="SearchHistoryItems" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                        <Button Tag="{Binding}" Click="SearchHistoryQueryClick" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></Button>
                                        <Button Grid.Column="1" Width="32" Height="32" Padding="8" Tag="{Binding}" Click="DeleteSearchHistoryClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="删除这条搜索历史" ToolTipService.ToolTip="删除"><FontIcon Glyph="&#xE711;" FontSize="12"/></Button>
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SearchKeywordHeading" Text="搜索建议" Margin="8,8,8,4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                                <ItemsControl x:Name="SearchKeywordItems"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Content="{Binding}" Click="SearchHistoryQueryClick" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" MinHeight="36"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                <TextBlock x:Name="SearchSongHeading" Text="相关歌曲" Margin="8,8,8,4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                                <ItemsControl x:Name="SearchSongItems"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="SearchSuggestedSongClick" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><local:CenteredCover Width="40" Height="40" CornerRadius="4" Source="{Binding Thumbnail, Converter={StaticResource SocialAvatar}, ConverterParameter=128}"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding UploaderDisplay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE768;" FontSize="14" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <!-- Keep the avatar inside the layout-reserved header area: a render transform
                     would shift it into the system caption buttons without layout knowing. -->
                <Button x:Name="AccountButton" Width="40" Height="40" Padding="4" CornerRadius="20" Margin="0,0,8,0"
                    Style="{StaticResource SubtleButtonStyle}" TitleBar.IsDragRegion="False" ToolTipService.ToolTip="账号" AutomationProperties.Name="账号">
                    <PersonPicture Width="28" Height="28" ProfilePicture="{x:Bind ViewModel.AccountAvatar, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="AccountFlyout" Placement="BottomEdgeAlignedRight" Opening="AccountFlyoutOpening" Closed="AccountFlyoutClosed">
                            <StackPanel Width="256" Spacing="20" Padding="8,12,8,8">
                                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.DebugModeVisibility, Mode=OneWay}"><TextBlock Text="离线调试 · 数据仅本次有效" TextWrapping="Wrap"/><Button Content="退出调试" Click="ExitDebugModeClick" HorizontalAlignment="Stretch"/></StackPanel>
                                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.LibraryVisibility, Mode=OneWay}">
                                    <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                        <Button Click="OwnSpaceClick" Style="{StaticResource SubtleButtonStyle}" Padding="0" AutomationProperties.Name="查看我的个人空间"><PersonPicture Width="104" Height="104" HorizontalAlignment="Left" VerticalAlignment="Top" ProfilePicture="{x:Bind ViewModel.AccountLargeAvatar, Mode=OneWay}"/></Button>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="6,3" CornerRadius="6" Background="#FB7299" Visibility="{x:Bind ViewModel.VipVisibility, Mode=OneWay}">
                                            <TextBlock Text="大会员" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <Grid HorizontalAlignment="Center" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Button x:Name="AccountNameButton" Click="OwnSpaceClick" Style="{StaticResource SubtleButtonStyle}" Padding="0" MaxWidth="182"><TextBlock Text="{x:Bind ViewModel.AccountName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/></Button>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="5,2" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}"><TextBlock Text="{x:Bind ViewModel.AccountLevel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <TextBlock Text="UID" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.AccountUid, Mode=OneWay}" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                        <Button x:Name="CopyUidButton" Click="CopyUidClick" Style="{StaticResource SubtleButtonStyle}" Padding="6" AutomationProperties.Name="复制 UID" ToolTipService.ToolTip="复制 UID"><FontIcon x:Name="CopyUidIcon" Glyph="&#xE8C8;" FontSize="14"/></Button>
                                    </StackPanel>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind ViewModel.FollowingLabel, Mode=OneWay}" Tag="following" Click="SocialListClick" HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="{x:Bind ViewModel.FollowersLabel, Mode=OneWay}" Tag="followers" Click="SocialListClick" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                    <Button Content="重新登录" Click="ReLoginClick" Visibility="{x:Bind ViewModel.ReLoginVisibility, Mode=OneWay}" HorizontalAlignment="Stretch"/>
                                    <Button Content="切换账号" Click="SwitchAccountClick" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                                    <Button Content="退出登录" Click="LogoutClick" Visibility="{x:Bind ViewModel.AccountLogoutVisibility, Mode=OneWay}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <TextBlock Text="请使用手机哔哩哔哩扫码登录。" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.LoginVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" Background="Transparent" />
    </Grid>
</Window>
